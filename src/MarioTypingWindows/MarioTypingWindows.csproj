<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mario Teaches Typing Native</AssemblyName>
    <RootNamespace>MarioTypingWindows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>kandowontu2 and contributors</Authors>
    <Product>Mario Teaches Typing Native</Product>
    <Copyright>Native port code © 2026 kandowontu2. Original game content belongs to its respective rights holders.</Copyright>
    <RepositoryUrl>https://github.com/kandowontu2/mario-teaches-typing-native</RepositoryUrl>
    <Description>Native Windows reimplementation of Mario Teaches Typing CD-ROM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\original\lessons\*.LEE">
      <LogicalName>MarioTypingWindows.Assets.Lessons.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\original\media\mario teaches typing.chd"
                      LogicalName="MarioTypingWindows.Assets.OriginalCd.chd" />
    <EmbeddedResource Include="..\..\assets\original\media\mario teaches typing.vhd"
                      LogicalName="MarioTypingWindows.Assets.OriginalInstall.vhd" />
    <EmbeddedResource Include="..\..\assets\original\game\MARIO\**\*">
      <LogicalName>MarioTypingWindows.Assets.Game.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\original\cd-audio\track02.wav"
                      LogicalName="MarioTypingWindows.Assets.CdAudio.Track02.wav" />
  </ItemGroup>
</Project>
